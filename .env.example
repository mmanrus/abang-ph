# ============================================================
# Abang PH
# Environment configuration example
# ============================================================

# PostgreSQL
#
# Development example:
# postgresql://abang:password@localhost:5433/abang_dev?schema=public
#
# Production should use the connection URL supplied by the
# managed PostgreSQL provider.
DATABASE_URL=""

# Application environment.
#
# Local machine:
# development
#
# Real deployed application:
# production
APP_ENV="development"

# Better Auth
#
# IMPORTANT:
# Generate a strong unique secret for production.
# Never reuse the development value.
# to generate console command > node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=""

# Development:
# http://localhost:3000
#
# Production:
# https://your-production-domain.com
BETTER_AUTH_URL="http://localhost:3000"